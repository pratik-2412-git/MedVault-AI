{
  "name": "medvault-ai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "workspaces": [
    "lib/db",
    "artifacts/api-server",
    "artifacts/medvault-ai"
  ],
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.31.4"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "build": "pnpm --filter @workspace/medvault-ai build && pnpm --filter @workspace/api-server build && node scripts/copy-frontend.mjs",
    "start": "pnpm --filter @workspace/api-server start",
    "db:schema": "psql -U postgres -d medvault -f lib/db/schema.sql",
    "db:seed": "psql -U postgres -d medvault -f lib/db/seed.sql"
  },
  "dependencies": {
    "drizzle-orm": "0.31.4"
  }
}